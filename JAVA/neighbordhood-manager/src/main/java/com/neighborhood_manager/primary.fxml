<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.neighborhood_manager.PrimaryController"
            style="-fx-background-color: #1a1a2e;">

    <top>
        <HBox style="-fx-background-color: #16213e; -fx-padding: 12 20 12 20; -fx-spacing: 10; -fx-alignment: CENTER_LEFT;"
              BorderPane.alignment="CENTER">

            <HBox spacing="8" alignment="CENTER">
                <FontIcon iconLiteral="fas-city" iconSize="18"/>
                <Label text="Neighborhood-Manger"
                       style="-fx-text-fill: #e94560; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Accueil" fx:id="btnHome" onAction="#goHome"
                    style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-padding: 8 16 8 16; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="Voisins" fx:id="btnVoisins" onAction="#goVoisins"
                    style="-fx-background-color: transparent; -fx-text-fill: #a8b2d8; -fx-font-size: 13px;
                           -fx-padding: 8 16 8 16; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="Annonces" fx:id="btnAnnonces" onAction="#goAnnonces"
                    style="-fx-background-color: transparent; -fx-text-fill: #a8b2d8; -fx-font-size: 13px;
                           -fx-padding: 8 16 8 16; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="Messages" fx:id="btnMessages" onAction="#goMessages"
                    style="-fx-background-color: transparent; -fx-text-fill: #a8b2d8; -fx-font-size: 13px;
                           -fx-padding: 8 16 8 16; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Region style="-fx-min-width: 20;"/>

            <Button text="Paramètres" fx:id="btnSettings" onAction="#goSettings"
                    style="-fx-background-color: #0f3460; -fx-text-fill: #a8b2d8; -fx-font-size: 16px;
                           -fx-padding: 8 12 8 12; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="Profil" fx:id="btnProfil"
                    style="-fx-background-color: #0f3460; -fx-text-fill: #a8b2d8; -fx-font-size: 16px;
                           -fx-padding: 8 12 8 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="24" style="-fx-padding: 40 60 40 60;" alignment="TOP_CENTER">

            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="searchField" promptText="Rechercher dans le quartier..."
                           style="-fx-background-color: #16213e; -fx-text-fill: white;
                                  -fx-prompt-text-fill: #a8b2d8; -fx-font-size: 14px;
                                  -fx-padding: 10 16 10 16; -fx-background-radius: 10;
                                  -fx-border-color: #0f3460; -fx-border-radius: 10;"
                           HBox.hgrow="ALWAYS" maxWidth="600"/>
            </HBox>

            <HBox spacing="20" alignment="CENTER">

                <VBox spacing="10" alignment="CENTER"
                      style="-fx-background-color: #16213e; -fx-padding: 30; -fx-background-radius: 14;
                             -fx-border-color: #0f3460; -fx-border-radius: 14; -fx-min-width: 180;">
                    <Label text="Voisins" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label text="24 connectés" style="-fx-text-fill: #a8b2d8; -fx-font-size: 12px;"/>
                </VBox>

                <VBox spacing="10" alignment="CENTER"
                      style="-fx-background-color: #16213e; -fx-padding: 30; -fx-background-radius: 14;
                             -fx-border-color: #e94560; -fx-border-radius: 14; -fx-min-width: 180;">
                    <Label text="Annonces" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label text="3 nouvelles" style="-fx-text-fill: #e94560; -fx-font-size: 12px;"/>
                </VBox>

                <VBox spacing="10" alignment="CENTER"
                      style="-fx-background-color: #16213e; -fx-padding: 30; -fx-background-radius: 14;
                             -fx-border-color: #0f3460; -fx-border-radius: 14; -fx-min-width: 180;">
                    <Label text="Messages" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label text="7 non lus" style="-fx-text-fill: #a8b2d8; -fx-font-size: 12px;"/>
                </VBox>

                <VBox spacing="10" alignment="CENTER"
                      style="-fx-background-color: #16213e; -fx-padding: 30; -fx-background-radius: 14;
                             -fx-border-color: #0f3460; -fx-border-radius: 14; -fx-min-width: 180;">
                    <Label text="Carte" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label text="Mon quartier" style="-fx-text-fill: #a8b2d8; -fx-font-size: 12px;"/>
                </VBox>

            </HBox>

            <VBox spacing="12"
                  style="-fx-background-color: #16213e; -fx-padding: 20; -fx-background-radius: 14;
                         -fx-border-color: #0f3460; -fx-border-radius: 14;" maxWidth="760">

                <Label text="Activité récente"
                       style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox>
                        <Label text="Marie D. a posté une annonce"
                               style="-fx-text-fill: #e2e8f0; -fx-font-size: 13px;"/>
                        <Label text="Il y a 5 minutes"
                               style="-fx-text-fill: #a8b2d8; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

                <Separator style="-fx-background-color: #0f3460;"/>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox>
                        <Label text="Nouveau message de Pierre L."
                               style="-fx-text-fill: #e2e8f0; -fx-font-size: 13px;"/>
                        <Label text="Il y a 12 minutes"
                               style="-fx-text-fill: #a8b2d8; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

                <Separator style="-fx-background-color: #0f3460;"/>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox>
                        <Label text="Sophie M. a rejoint le quartier"
                               style="-fx-text-fill: #e2e8f0; -fx-font-size: 13px;"/>
                        <Label text="Il y a 1 heure"
                               style="-fx-text-fill: #a8b2d8; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox style="-fx-background-color: #16213e; -fx-padding: 10 20; -fx-alignment: CENTER_RIGHT;">
            <Label text="Neighborhood-Manger v1.0  —  Connectez votre quartier"
                   style="-fx-text-fill: #4a5568; -fx-font-size: 11px;"/>
        </HBox>
    </bottom>

</BorderPane>