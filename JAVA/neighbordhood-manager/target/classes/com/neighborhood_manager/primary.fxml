<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.DropShadow?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.neighborhood_manager.PrimaryController"
            styleClass="main-container">

    <top>
        <HBox styleClass="top-navbar" BorderPane.alignment="CENTER">
            <VBox alignment="CENTER" spacing="-5">
                <HBox alignment="CENTER">
                    <Label text="petits" styleClass="logo-text-primary"/>
                    <Label text="secrets" styleClass="logo-text-primary"/>
                </HBox>
                <Label text="entrevoisins" styleClass="logo-text-secondary"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Accueil" fx:id="btnHome" onAction="#goHome" styleClass="nav-button-active">
                    <graphic><FontIcon iconLiteral="fas-home" iconSize="14" iconColor="white"/></graphic>
                </Button>

                <Button text="Voisins" fx:id="btnVoisins" onAction="#goVoisins" styleClass="nav-button">
                    <graphic><FontIcon iconLiteral="fas-users" iconSize="14" iconColor="#8BA0B8"/></graphic>
                </Button>

                <Button text="Annonces" fx:id="btnAnnonces" onAction="#goAnnonces" styleClass="nav-button">
                    <graphic><FontIcon iconLiteral="fas-bullhorn" iconSize="14" iconColor="#8BA0B8"/></graphic>
                </Button>

                <Button text="Incidents" fx:id="btnIncidents" onAction="#goIncidents" styleClass="nav-button">
                    <graphic><FontIcon iconLiteral="fas-exclamation-triangle" iconSize="14" iconColor="#8BA0B8"/></graphic>
                </Button>

                <Button text="Messages" fx:id="btnMessages" onAction="#goMessages" styleClass="nav-button">
                    <graphic><FontIcon iconLiteral="fas-envelope" iconSize="14" iconColor="#8BA0B8"/></graphic>
                </Button>
            </HBox>

            <Region style="-fx-min-width: 30;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnSettings" onAction="#goSettings" styleClass="icon-button-outline">
                    <graphic><FontIcon iconLiteral="fas-cog" iconSize="16" iconColor="#8BA0B8"/></graphic>
                </Button>
                <Button text="Profil Admin" fx:id="btnProfil" styleClass="icon-button-outline">
                    <graphic><FontIcon iconLiteral="fas-user-shield" iconSize="16" iconColor="#8BA0B8"/></graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox fx:id="mainContent" spacing="30" styleClass="content-area" alignment="TOP_CENTER">

            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="searchField" promptText="Rechercher un résident, un contrat..."
                           styleClass="main-search-field" HBox.hgrow="ALWAYS" maxWidth="650"/>
            </HBox>

            <HBox spacing="25" alignment="CENTER">
                <VBox spacing="10" alignment="CENTER" styleClass="stat-card">
                    <Label text="Voisins" styleClass="stat-card-title"/>
                    <Label fx:id="lblNbVoisins" text="Chargement..." styleClass="stat-card-value"/>
                </VBox>

                <VBox spacing="10" alignment="CENTER" styleClass="stat-card-highlight">
                    <Label text="Annonces" styleClass="stat-card-title-white"/>
                    <Label fx:id="lblNbAnnonces" text="3 nouvelles" styleClass="stat-card-value-orange"/>
                </VBox>

                <VBox spacing="10" alignment="CENTER" styleClass="stat-card">
                    <Label text="Incidents" styleClass="stat-card-title"/>
                    <Label fx:id="lblNbIncidents" text="0 en cours" styleClass="stat-card-value"/>
                </VBox>

                <VBox spacing="10" alignment="CENTER" styleClass="stat-card">
                    <Label text="Synchro" styleClass="stat-card-title"/>
                    <Label fx:id="lblSyncStatus" text="Mode Offline" styleClass="stat-card-value-small"/>
                </VBox>
            </HBox>

            <VBox spacing="15" styleClass="activity-panel" maxWidth="835">
                <Label text="Dernières actions d'administration" styleClass="panel-header"/>
                <Separator styleClass="panel-separator"/>
                <Label text="Aucune action récente en attente de synchronisation." styleClass="empty-state-text"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="footer-bar">
            <Label text="Connecté en tant qu'Administrateur Quartier — Base Locale SQLite Active" styleClass="footer-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="v1.0.0-stable" styleClass="footer-text"/>
        </HBox>
    </bottom>

</BorderPane>